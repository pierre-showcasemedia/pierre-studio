# Studio environment variables. NAMES ONLY: never put a real value in this
# file or anywhere in the repo. Real values go in the buyer's own Vercel
# project (Settings → Environment Variables), pasted by the buyer, and for
# local scripts in an untracked .env.local. Business details (name, contact,
# domains, time zone) are not env vars: they live in src/lib/business.ts.

# ---- Core (required in production) ----
# Neon Postgres connection string (added from Vercel Storage on this project). Unset = demo mode with sample data.
DATABASE_URL=
# Random 32+ byte hex string that signs magic-link and session JWTs (openssl rand -hex 32).
AUTH_SECRET=
# Base URL of this app (magic links, delivery emails, cover images). Default business.portalUrl.
NEXT_PUBLIC_SITE_URL=
# Guards /api/portal/migrate and /api/portal/admin-api (sent as the x-migrate-token header).
MIGRATE_TOKEN=

# ---- Email (the buyer's Resend, a verified sending domain) ----
RESEND_API_KEY=
# Sender for every email. Default business.emailFrom.
EMAIL_FROM=
# Reply-to on client emails and the address shown when something fails. Default business.supportEmail.
SUPPORT_EMAIL=
# The phone clients see. Leave empty to use business.phone; never a personal number.
SUPPORT_PHONE=
# Public base URL for images inside emails (logo, cover). Default business.portalUrl.
EMAIL_ASSET_BASE=

# ---- People (comma separated emails, all empty by default) ----
# Who can open /admin and use "View as". Set at least one.
ADMIN_EMAILS=
# Who gets "gallery approved" and "revision requested" notifications. Defaults to ADMIN_EMAILS.
NOTIFY_EMAILS=
# Always CCed on every delivery email. Empty = no automatic CC.
DELIVERY_CC=
# Partner logins: see every PAID listing read-only with downloads, never invoices.
PARTNER_EMAILS=
# Listing ids and slugs partners must never see (NDA or confidential listings).
PARTNER_EXCLUDED_IDS=
PARTNER_EXCLUDED_SLUGS=
# The shooter put on a new booking when the website names none (optional).
DEFAULT_SHOOTER_EMAIL=

# ---- Media storage (the buyer's Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Payments (business.payments = "stripe"; docs/booking-to-payment.md) ----
# The buyer's own Stripe account. Creates and finalizes the invoice at booking
# and verifies webhook events. Preview and production never share a key.
# Unset = card bookings keep their invoice job queued and the booking email
# goes without a pay button.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint /api/portal/stripe-webhook
# (events: invoice.paid and the invoice lifecycle; invoice.paid unlocks the gallery).
STRIPE_WEBHOOK_SECRET=
# Pay at close through Titus: only when business.payAtClose is true.
TITUS_API_KEY=
TITUS_WEBHOOK_SECRET=
TITUS_API_BASE_URL=
NEXT_PUBLIC_TITUS_WEB_BASE_URL=

# ---- Booking intake (the website posts every booking here) ----
# The website's /api/booking posts to POST /api/studio/bookings with this value
# in x-intake-secret (= STUDIO_INTAKE_SECRET on the website). Unset = the intake routes answer 404.
BOOKING_INTAKE_SECRET=
# Public pre-shoot checklist page linked from the booking confirmation email. Unset = hidden.
PRESHOOT_CHECKLIST_URL=

# ---- Public site links ----
# The marketing site linked from the portal. Default business.marketingUrl.
NEXT_PUBLIC_MARKETING_URL=
# Dropbox app key for the client "Add to Dropbox" button and the admin picker. Empty hides both.
NEXT_PUBLIC_DROPBOX_APP_KEY=

# ---- Editing (business.editing = "autohdr"; src/lib/autohdr.ts + src/lib/pipeline.ts) ----
# OAuth2 client of the buyer's AutoHDR API client. Unset = shoots park at
# "uploaded" with an admin banner; files stay safe in R2.
AUTOHDR_CLIENT_ID=
AUTOHDR_CLIENT_SECRET=
AUTOHDR_API_BASE_URL=
AUTOHDR_TOKEN_URL=
STUDIO_TWILIGHT_DEFAULT_LOOK=
# Per-model credit costs when they differ from the API list, "modelId=credits,...".
STUDIO_CREDIT_OVERRIDES=
# Bearer token Vercel sends with every cron call (Vercel adds it for projects with crons).
CRON_SECRET=
# Seconds one pipeline run may work before it returns (default 50).
PIPELINE_STEP_SECONDS=
# Image work per server instance (optional; src/lib/image-gate.ts).
IMAGE_PIXEL_BUDGET_MP=
IMAGE_ORIGINALS_AT_ONCE=
IMAGE_WARN_RSS_MB=

# ---- Automatic QC and the revision intake (src/lib/qc.ts, src/lib/revision-intake.ts) ----
# Anthropic API key. Unset = the QC pass is skipped with a visible note.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
STUDIO_QC_MODEL=
STUDIO_QC_MAX_FRAMES=
STUDIO_INTAKE_MODEL=

# ---- Slack (src/lib/slack.ts; all optional, never a dollar amount except the payments channel) ----
SLACK_WEBHOOK_URL=
# The private payments channel, the one place Slack may carry amounts.
SLACK_PAYMENTS_WEBHOOK_URL=
SLACK_BOOKINGS_WEBHOOK_URL=
SLACK_PHOTO_EDITING_WEBHOOK_URL=
SLACK_VIDEO_EDITING_WEBHOOK_URL=
SLACK_PHOTO_REVIEW_WEBHOOK_URL=
# Slack member ids (U...) tagged on photo and video editing lines. Unset = nobody is tagged.
SLACK_PHOTO_EDITING_TAG=
SLACK_VIDEO_EDITING_TAG=

# ---- Google Calendar for bookings (service account with domain-wide delegation) ----
GOOGLE_SA_CLIENT_EMAIL=
# base64 of the PEM private key
GOOGLE_SA_PRIVATE_KEY=
# The mailbox the service account acts as. Default business.supportEmail.
GOOGLE_CALENDAR_IMPERSONATE=
# The shoots calendar id (default "primary") and an optional second bookings calendar.
GOOGLE_CALENDAR_ID=
GOOGLE_BOOKINGS_CALENDAR=
# Calendar sync runs on production only; "on" turns it on elsewhere, "off" anywhere.
GOOGLE_CALENDAR_SYNC=

# ---- Shoot brief (src/lib/shoot-brief.ts), emailed before every shoot ----
# To the booking's shooter, else SHOOT_BRIEF_FALLBACK (else the first NOTIFY_EMAILS); CC SHOOT_BRIEF_CC.
SHOOT_BRIEF_FALLBACK=
SHOOT_BRIEF_CC=
# Client notes from a private GitHub repo (fine-grained token, Contents read-only). All unset = off.
BRAIN_GITHUB_TOKEN=
BRAIN_REPO=
BRAIN_BRANCH=

# ---- Dropbox raw mirror (src/lib/dropbox.ts, src/lib/dropbox-mirror.ts) ----
DROPBOX_APP_SECRET=
# Root folder for every listing. Default /Listings
DROPBOX_LISTINGS_ROOT=
# Production only; "on" turns it on elsewhere, "off" anywhere.
DROPBOX_MIRROR=

# ---- Quo, the business texting line (src/lib/quo.ts). READ ONLY: the studio never texts. ----
QUO_WEBHOOK_SECRET=
QUO_API_KEY=
# The business inbox into the revision intake (src/lib/email-intake.ts): "on" or "off".
EMAIL_INTAKE=

# ---- Scripts ----
# scripts/push-to-listing.mjs: the portal it pushes to (default business.portalUrl).
STUDIO_PORTAL_URL=
# A *.vercel.app preview also needs this to get past deployment protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
# scripts/upload-listing-media.mjs
PORTAL_API=
PHOTO_PREFIX=
UPLOAD_PART_MB=
UPLOAD_QUEUE=
WM_WIDTH=
# scripts/check-pricing.ts: the website checkout to compare src/lib/booking-pricing.ts with.
SITE_DIR=
# scripts/check-roles-http.mjs: the admin it signs in as.
CHECK_ADMIN_EMAIL=
